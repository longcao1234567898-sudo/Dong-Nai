# =====================================================================
#  BIẾN MÔI TRƯỜNG GIAO DIỆN (thư mục gốc, .env)
#  MẪU — chép thành .env rồi điền. Tệp .env KHÔNG lên GitHub (.gitignore chặn).
#  Trên Netlify KHÔNG cần khai: netlify.toml đã khai sẵn hai biến này cho
#  bản dựng. Tệp này chỉ dùng khi chạy trên máy.
# =====================================================================

# Địa chỉ máy chủ Render, KHÔNG có dấu / ở cuối.
# Ví dụ: https://du-lich-dong-nai-api.onrender.com
# Chạy trên máy (npm run dev) thì để trống: Vite tự chuyển /api sang localhost:4000
VITE_API_URL=

# Cloudflare Turnstile, khoá CÔNG KHAI (Site Key). Để trống = tắt cổng kiểm tra lúc mới vào trang.
# Đi cặp với TURNSTILE_SECRET_KEY trên Render.
VITE_TURNSTILE_SITE_KEY=
