# =====================================================================
#  BIẾN MÔI TRƯỜNG GIAO DIỆN (thư mục gốc, .env)
#  MẪU — chép thành .env rồi điền. Tệp .env KHÔNG lên GitHub (.gitignore chặn).
#  Trên Netlify: Site configuration → Environment variables, khai đúng hai
#  biến này rồi bấm "Clear cache and deploy site" (biến VITE_ được gắn
#  vào lúc dựng, khai xong mà không dựng lại thì không có tác dụng).
# =====================================================================

# Địa chỉ máy chủ Render, KHÔNG có dấu / ở cuối.
# Ví dụ: https://du-lich-dong-nai-api.onrender.com
# Chạy trên máy (npm run dev) thì để trống: Vite tự chuyển /api sang localhost:4000
VITE_API_URL=

# Cloudflare Turnstile, khoá CÔNG KHAI (Site Key). Để trống = tắt ô xác minh
VITE_TURNSTILE_SITE_KEY=
