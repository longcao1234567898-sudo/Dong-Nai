# =====================================================================
#  BIẾN MÔI TRƯỜNG MÁY CHỦ (server/.env)
#  MẪU — chép thành server/.env rồi điền. Tệp .env KHÔNG lên GitHub
#  (.gitignore chặn) vì chứa mật khẩu. Render: Environment → Add from .env.
#  Giá trị có dấu # thì PHẢI đặt trong nháy kép, ví dụ DB_PASSWORD="Ab#123"
# =====================================================================

# ---------- Chung
PORT=4000
# Render: production. Chạy thử trên máy: development
NODE_ENV=development

# ---------- Cơ sở dữ liệu MySQL
# Aiven: lấy ở trang Overview của dịch vụ MySQL (Host, Port, User, Password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Tên cơ sở dữ liệu đã nạp tệp du_lich_dong_nai.sql (Aiven mặc định: defaultdb)
DB_NAME=du_lich_dong_nai

# ---------- Kết nối mã hoá tới Aiven (chọn MỘT trong hai cách, không khai DB_SSL)
# Cách 1 (nên dùng): Render → Secret Files, tên tệp ca.pem, dán nội dung CA
#   của Aiven, rồi điền DB_SSL_CA=/etc/secrets/ca.pem. Máy cục bộ: để trống.
#   (Khai đường dẫn mà tệp chưa có thì máy chủ không khởi động được.)
DB_SSL_CA=
# Cách 2: dán thẳng nội dung ca.pem vào đây (khi đó xoá trống DB_SSL_CA ở trên)
DB_SSL_CA_PEM=
# Chỉ dùng cho nhà cung cấp có chứng chỉ công khai. Với Aiven để trống.
DB_SSL=

# ---------- Khoá bí mật — tạo bằng lệnh: node scripts-tao-khoa.js (trong thư mục server)
JWT_SECRET=
HASH_PEPPER=

# ---------- Địa chỉ giao diện (Netlify), KHÔNG có dấu / ở cuối
# Nhiều địa chỉ thì ngăn bằng dấu phẩy
CORS_ORIGIN=
CLIENT_URL=http://localhost:5173

# ---------- Cloudflare Turnstile, khoá BÍ MẬT (Secret Key). Để trống = tắt cổng kiểm tra chống người máy.
# Đi cặp với VITE_TURNSTILE_SITE_KEY trên Netlify (cùng tài khoản Cloudflare). Khai khoá này mà
# Netlify thiếu site key thì không ai gửi đánh giá, phản ánh hay đăng nhập được.
TURNSTILE_SECRET_KEY=

# ---------- Khoá mã hoá bản sao lưu (scripts-sao-luu.js). Ít nhất 16 ký tự,
# ghi ra giấy cất riêng: mất khoá là không mở được bản sao lưu. Để trống = không mã hoá
KHOA_SAO_LUU=
