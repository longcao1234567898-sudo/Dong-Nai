PORT=4000
NODE_ENV=development

# Cơ sở dữ liệu MySQL 8
# ⚠️ Mật khẩu có ký tự # thì PHẢI đặt trong nháy kép: DB_PASSWORD="Ab#123..."
#    Không có nháy, mọi thứ từ dấu # trở đi bị coi là ghi chú và bị cắt mất.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=du_lich_dong_nai
# Cơ sở dữ liệu trên mây (Aiven, VNPT...): bật DB_SSL=true, HOẶC khai DB_SSL_CA trỏ tới tệp chứng chỉ. Không khai cả hai.
DB_SSL=
DB_SSL_CA=

# Tạo bằng: node scripts-tao-khoa.js
JWT_SECRET=
HASH_PEPPER=

# Địa chỉ giao diện, ngăn bằng dấu phẩy. Ví dụ: https://du-lich-dong-nai.netlify.app
CORS_ORIGIN=
CLIENT_URL=

# Khoá bí mật Cloudflare Turnstile (để trống thì tắt ô xác minh)
TURNSTILE_SECRET_KEY=
